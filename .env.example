# ============================================================
# Revalidacion por demanda del cache de datos del servidor
# (ver app/api/revalidate-navigation/route.ts)
# ============================================================
# OJO: a proposito NO lleva el prefijo NEXT_PUBLIC_. Las variables con ese
# prefijo Next.js las mete en el bundle que descarga el navegador (serian
# visibles para cualquiera); esta tiene que quedar SOLO en el servidor,
# porque es la "contraseña" que protege quien puede invalidar el cache.
# Poné cualquier texto largo y random (ej. generalo con
# `openssl rand -hex 32` o similar).
REVALIDATE_SECRET=


