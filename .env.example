# Copia este archivo como .env (NO se sube a git; en produccion tambien
# se llama .env, generado por el pipeline de deploy antes de "next build").
#
# Cada backend tiene SU PROPIO interruptor de entorno (local/development/production),
# independiente de los demas -- podes tener "core" en local y "billing" en
# production al mismo tiempo, en el mismo archivo. Para cambiar el interruptor
# de un backend, corre "npm run env:select" (te pregunta cual backend y que
# entorno; las URLs las segui completando aca a mano, una sola vez).
#
# Convencion de nombres: NEXT_PUBLIC_<BACKEND>_<GRUPO>_URL_<ENTORNO>
# "grupo" = una familia de rutas del MISMO backend/servidor (api, storage,
# webhooks, cdn, etc). Un backend puede tener uno o varios grupos.
#
# Al sumar un backend o grupo nuevo: agregarlo tambien en
# shared/config/environments.ts (esta comentado como ejemplo alli).

# ============================================================
# Backend "core" -- API principal del negocio (real, en uso)
# ============================================================
NEXT_PUBLIC_CORE_ENV=local

# grupo "api": SOLO el host, sin version (la version va en cada endpoint).
NEXT_PUBLIC_CORE_API_URL_LOCAL=http://10.36.102.211:8000
NEXT_PUBLIC_CORE_API_URL_DEVELOPMENT=https://api.dev.carpinteriacillat.com
NEXT_PUBLIC_CORE_API_URL_PRODUCTION=https://api.carpinteriacillat.com

# grupo "storage": mismo backend, otra ruta (imagenes, documentos).
NEXT_PUBLIC_CORE_STORAGE_URL_LOCAL=http://10.36.102.211:8000/storage
NEXT_PUBLIC_CORE_STORAGE_URL_DEVELOPMENT=https://api.dev.carpinteriacillat.com/storage
NEXT_PUBLIC_CORE_STORAGE_URL_PRODUCTION=https://api.carpinteriacillat.com/storage

# ============================================================
# Backend "billing" -- ejemplo (no hay servidor real detras todavia)
# Muestra un backend con DOS grupos de rutas distintos: la api normal,
# y un endpoint aparte de webhooks (paradas de pago, etc).
# ============================================================
NEXT_PUBLIC_BILLING_ENV=local

NEXT_PUBLIC_BILLING_API_URL_LOCAL=http://10.36.102.212:8001
NEXT_PUBLIC_BILLING_API_URL_DEVELOPMENT=
NEXT_PUBLIC_BILLING_API_URL_PRODUCTION=

NEXT_PUBLIC_BILLING_WEBHOOKS_URL_LOCAL=http://10.36.102.212:8001/webhooks
NEXT_PUBLIC_BILLING_WEBHOOKS_URL_DEVELOPMENT=
NEXT_PUBLIC_BILLING_WEBHOOKS_URL_PRODUCTION=

# ============================================================
# Backend "media" -- ejemplo (no hay servidor real detras todavia)
# Muestra un backend que es TODO archivos: api de metadata + un cdn
# distinto para servir el contenido ya procesado.
# ============================================================
NEXT_PUBLIC_MEDIA_ENV=local

NEXT_PUBLIC_MEDIA_API_URL_LOCAL=http://10.36.102.213:8002
NEXT_PUBLIC_MEDIA_API_URL_DEVELOPMENT=
NEXT_PUBLIC_MEDIA_API_URL_PRODUCTION=

NEXT_PUBLIC_MEDIA_CDN_URL_LOCAL=http://10.36.102.213:8002/cdn
NEXT_PUBLIC_MEDIA_CDN_URL_DEVELOPMENT=
NEXT_PUBLIC_MEDIA_CDN_URL_PRODUCTION=

# ---- Otras variables, sin relacion a backends ----
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_CLIENT=web


