# Copia este archivo como .env.local (NO se sube a git).
#
# Cada backend tiene SU PROPIO interruptor de entorno (local/development/production),
# independiente de los demas. Para cambiar, corre "npm run env:select": te pregunta
# que backend y que entorno, y edita este archivo por vos.
NEXT_PUBLIC_CORE_ENV=local
# NEXT_PUBLIC_BILLING_ENV=local

NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_CLIENT=web
